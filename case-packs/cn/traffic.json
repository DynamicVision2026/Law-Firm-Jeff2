  "questions": [
    {
      "id": "injured",
      "text": "您在事故中受伤了吗？",
      "type": "single",
      "options": [
        {
          "value": "yes",
          "label": "是"
        },
        {
          "value": "no",
          "label": "否（只有财产损失）"
        }
      ]
    },
    {
      "id": "injury_type",
      "text": "主要伤情是？",
      "type": "single",
      "show_if": {
        "injured": "yes"
      },
      "options": [
        {
          "value": "whiplash",
          "label": "颈部扭伤・挫伤・扭伤"
        },
        {
          "value": "fracture",
          "label": "骨折"
        },
        {
          "value": "serious",
          "label": "头部・内脏等严重伤害"
        },
        {
          "value": "unknown",
          "label": "不清楚"
        }
      ]
    },
    {
      "id": "treatment_months",
      "text": "到目前为止的治疗（门诊・住院）时间？",
      "type": "single",
      "show_if": {
        "injured": "yes"
      },
      "options": [
        {
          "value": "0",
          "label": "还未就医"
        },
        {
          "value": "1",
          "label": "不到1个月"
        },
        {
          "value": "3",
          "label": "1～3个月"
        },
        {
          "value": "6",
          "label": "3～6个月"
        },
        {
          "value": "7",
          "label": "6个月以上"
        }
      ]
    },
    {
      "id": "treatment_status",
      "text": "目前治疗情况？",
      "type": "single",
      "show_if": {
        "injured": "yes"
      },
      "options": [
        {
          "value": "ongoing",
          "label": "治疗中"
        },
        {
          "value": "finished",
          "label": "已治疗结束"
        },
        {
          "value": "fixed",
          "label": "医生表示可能留有后遗症（可做伤残鉴定）"
        }
      ]
    },
    {
      "id": "fault",
      "text": "事故责任划分（就您所知）？",
      "type": "single",
      "options": [
        {
          "value": "other_100",
          "label": "对方全责（例如追尾）"
        },
        {
          "value": "other_most",
          "label": "对方主要责任"
        },
        {
          "value": "shared",
          "label": "同等责任"
        },
        {
          "value": "me_most",
          "label": "自己主要责任"
        },
        {
          "value": "unknown",
          "label": "不清楚"
        }
      ]
    },
    {
      "id": "insurer_offer",
      "text": "对方或保险公司是否已提出赔偿金额？",
      "type": "single",
      "options": [
        {
          "value": "none",
          "label": "还没有"
        },
        {
          "value": "offered",
          "label": "已提出，但还未同意"
        },
        {
          "value": "signed",
          "label": "已经签署调解或和解协议"
        }
      ]
    },
    {
      "id": "lawyer_rider",
      "text": "您的保险是否有法律费用相关条款？",
      "type": "single",
      "help": "部分商业车险附有法律费用相关条款，请查看保单。",
      "options": [
        {
          "value": "yes",
          "label": "有"
        },
        {
          "value": "no",
          "label": "没有"
        },
        {
          "value": "unknown",
          "label": "不清楚"
        }
      ]
    },
    {
      "id": "accident_when",
      "text": "事故是什么时候发生的？",
      "type": "single",
      "options": [
