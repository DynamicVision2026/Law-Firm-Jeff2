  "jeff": {
    "recommendation": {
      "question": "Should this person consult a lawyer about this traffic accident?",
      "options": [
        "high",
        "medium",
        "low"
      ]
    },
    "urgency": {
      "question": "How urgent is this case?",
      "options": [
        "urgent",
        "normal"
      ]
    },
    "factors": {
      "question": "Which of these factors apply to this case? (choose all that apply)",
      "multi": true,
      "options": [
        "long_treatment",
        "serious_injury",
        "other_party_at_fault",
        "fault_disputed",
        "offer_received",
        "lawyer_rider",
        "possible_after_effects",
        "property_only"
      ]
    },
    "review_threshold": 0.6
  },
  "rules": {
    "_comment": "Lawyer-written scoring used when Jeff is not running, and as the comparison baseline. DRAFT.",
    "score": [
      {
        "if": {
          "injured": "yes"
        },
        "add": 2
      },
      {
        "if": {
          "injury_type": "fracture"
        },
        "add": 2
      },
      {
        "if": {
          "injury_type": "serious"
        },
        "add": 4
      },
      {
        "if": {
          "treatment_months": "3"
        },
        "add": 1
      },
      {
        "if": {
          "treatment_months": [
            "6",
            "7"
          ]
        },
        "add": 2
      },
      {
        "if": {
          "treatment_status": "fixed"
        },
        "add": 2
      },
      {
        "if": {
          "fault": [
            "other_100",
            "other_most"
          ]
        },
        "add": 1
      },
      {
        "if": {
          "fault": "shared"
        },
        "add": 1
      },
      {
        "if": {
          "insurer_offer": "offered"
        },
        "add": 2
      },
      {
        "if": {
          "lawyer_rider": "yes"
        },
        "add": 2
      },
      {
        "if": {
          "fault": "me_most"
        },
        "add": -1
      },
      {
        "if": {
          "injured": "no"
        },
        "add": -1
      }
    ],
    "recommendation_levels": {
      "high": 6,
      "medium": 3
    },
    "value_levels": {
      "high": 7,
      "medium": 3
    },
    "factors": [
      {
        "factor": "serious_injury",
        "if": {
          "injury_type": [
            "fracture",
            "serious"
          ]
        }
      },
      {
        "factor": "possible_after_effects",
        "if": {
          "treatment_status": "fixed"
        }
      },
      {
        "factor": "offer_received",
        "if": {
          "insurer_offer": "offered"
        }
      },
      {
        "factor": "long_treatment",
        "if": {
          "treatment_months": [
            "6",
            "7"
          ]
        }
      },
      {
        "factor": "lawyer_rider",
        "if": {
          "lawyer_rider": "yes"
        }
      },
      {
        "factor": "fault_disputed",
        "if": {
          "fault": [
            "shared",
            "unknown"
          ]
        }
      },
      {
        "factor": "other_party_at_fault",
        "if": {
          "fault": [
            "other_100",
            "other_most"
          ]
        }
      },
      {
        "factor": "property_only",
        "if": {
          "injured": "no"
        }
      }
    ],
    "urgency": [
      {
        "if": {
          "insurer_offer": "signed"
        }
      },
      {
        "if": {
          "accident_when": [
            "1to3y",
            "gt3y"
          ]
        }
      },
      {
        "if": {
          "insurer_offer": "offered"
        }
      }
    ]
  },
  "calculator": null,
  "factors": {
    "long_treatment": "治疗时间越长，赔偿项目通常越多，越值得仔细评估。",
    "serious_injury": "骨折或严重伤害，赔偿金额通常较大。",
    "other_party_at_fault": "对方责任较大时，您可获得的赔偿比例更高。",
    "fault_disputed": "责任划分有争议时，经专业人士确认后结果可能不同。",
    "offer_received": "对方或保险公司提出的金额，未必包含您可主张的全部项目。",
    "lawyer_rider": "如有法律费用相关条款，咨询或委托律师的负担可能较小。",
    "possible_after_effects": "如构成伤残，伤残赔偿金可能大幅增加，需做伤残鉴定。",
    "property_only": "只有财产损失时，委托律师的费用有时会高于可获赔偿。"
  },
  "warnings": [
    {
      "id": "signed_settlement",
      "if": {
        "insurer_offer": "signed"
      },
      "level": "high",
      "text": "已签署调解或和解协议的，原则上很难再重新主张，请尽快请专业人士确认。"
    },
    {
      "id": "deadline_near",
      "if": {
        "accident_when": [
          "1to3y",
          "gt3y"
        ]
      },
      "level": "high",
      "text": "诉讼时效一般为3年，自知道权利受损及义务人之日起计算，请尽快处理。"
    },
    {
      "id": "keep_report",
      "if": {
        "injured": "yes"
      },
      "level": "medium",
      "text": "请保存好《交通事故认定书》、病历、诊断证明和费用票据。"
    },
    {
      "id": "dont_sign_yet",
      "if": {
        "insurer_offer": "offered"
      },
      "level": "medium",
      "text": "如对赔偿金额有疑问，请先不要签署协议。"
    },
    {
      "id": "keep_treating",
      "if": {
        "treatment_status": "ongoing"
      },
      "level": "info",
      "text": "治疗期间请遵医嘱持续就医。"
    }
  ],
  "result": {
    "headline": {
      "high": "建议咨询律师：程度【高】",
      "medium": "建议咨询律师：程度【中】",
      "low": "建议咨询律师：程度【低】"
    },
    "value_label": "案件初步评估",
    "value": {
      "high": "这可能是赔偿金额较大的案件",
      "medium": "金额会因具体情况而不同",
      "low": "金额可能相对较小"
    },
    "range_label": "参考金额",
    "next_step": {
      "high": "建议尽早咨询专业律师。",
      "medium": "在签署任何协议之前，建议先请专业人士确认。",
      "low": "请先保存相关证据和票据。也可以通过交警部门或人民调解委员会进行调解。"
    },
    "cost_note": "经济困难的，可向当地法律援助中心申请法律援助（有条件限制），也可拨打12348法律服务热线咨询。",
    "supervision_label": "律师审核",
    "disclaimer": "本诊断仅提供一般性信息，不构成法律意见。实际金额与结果会因个案情况而不同。"
  }
}