{
  "meta": {
    "market": "cn",
    "case_type": "traffic",
    "language": "zh-Hans",
    "title": "交通事故 免费案件初步诊断",
    "status": "draft",
    "approved_by": "",
    "reviewed_on": "",
    "notes_for_reviewers": "DRAFT by Claude for mainland lawyer review. Deadlines (民法典第188条), wording and cost info must be confirmed. No amount table yet — compensation standards vary by province; mainland lawyers to supply one."
