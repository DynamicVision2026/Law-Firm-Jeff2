{
  "meta": {
    "market": "tw",
    "case_type": "traffic",
    "language": "zh-Hant",
    "title": "車禍 免費案件初步診斷",
    "status": "draft",
    "approved_by": "",
    "reviewed_on": "",
    "notes_for_reviewers": "DRAFT by Claude for Taiwan lawyer review. Deadlines (民法197條、刑事告訴期間), wording and cost info must be confirmed. No amount table yet — Taiwan lawyers to supply one."
  },
  "questions": [
    {
      "id": "injured",
      "text": "您在車禍中受傷了嗎？",
      "type": "single",
      "options": [
        {
          "value": "yes",
          "label": "是"
        },
        {
          "value": "no",
          "label": "否（只有財物損失）"
        }
      ]
    },
    {
      "id": "injury_type",
      "text": "主要的傷勢是？",
      "type": "single",
      "show_if": {
        "injured": "yes"
      },
      "options": [
        {
          "value": "whiplash",
          "label": "頸部扭傷・挫傷・扭傷"
        },
        {
          "value": "fracture",
          "label": "骨折"
        },
        {
          "value": "serious",
          "label": "頭部・內臟等嚴重傷害"
        },
        {
          "value": "unknown",
          "label": "不清楚"
        }
      ]
    },
    {
      "id": "treatment_months",
      "text": "到目前為止的就醫（門診・住院）期間？",
      "type": "single",
      "show_if": {
        "injured": "yes"
      },
      "options": [
        {
          "value": "0",
          "label": "尚未就醫"
        },
        {
          "value": "1",
          "label": "未滿1個月"
        },
        {
          "value": "3",
          "label": "1～3個月"
        },
        {
          "value": "6",
          "label": "3～6個月"
        },
        {
          "value": "7",
          "label": "6個月以上"
        }
      ]
    },
    {
      "id": "treatment_status",
      "text": "目前治療狀況？",
      "type": "single",
      "show_if": {
        "injured": "yes"
      },
      "options": [
        {
          "value": "ongoing",
          "label": "治療中"
        },
        {
          "value": "finished",
          "label": "已經治療結束"
        },
        {
          "value": "fixed",
          "label": "醫師表示傷勢已固定、可能有後遺症"
        }
      ]
    },
    {
      "id": "fault",
      "text": "事故的過失比例（就您所知）？",
      "type": "single",
      "options": [
        {
          "value": "other_100",
          "label": "對方100%過失（例如被追撞）"
        },
        {
          "value": "other_most",
          "label": "主要是對方過失"
        },
        {
          "value": "shared",
          "label": "雙方差不多"
        },
        {
          "value": "me_most",
          "label": "主要是自己過失"
        },
        {
          "value": "unknown",
          "label": "不清楚"
        }
      ]
    },
    {
      "id": "insurer_offer",
      "text": "對方或保險公司是否已提出和解金額？",
      "type": "single",
      "options": [
        {
          "value": "none",
          "label": "還沒有"
        },
        {
          "value": "offered",
          "label": "已提出，但尚未同意"
        },
        {
          "value": "signed",
          "label": "已經簽署和解書"
        }
      ]
    },
    {
      "id": "lawyer_rider",
      "text": "您的保險是否有法律費用相關的附加條款？",
      "type": "single",
      "help": "部分汽車保險附有法律費用相關附加條款，請確認保單。",
      "options": [
        {
          "value": "yes",
          "label": "有"
        },
        {
          "value": "no",
          "label": "沒有"
        },
        {
          "value": "unknown",
          "label": "不清楚"
        }
      ]
    },
    {
      "id": "accident_when",
      "text": "車禍是什麼時候發生的？",
      "type": "single",
      "options": [
        {
          "value": "lt6m",
          "label": "6個月內"
        },
        {
          "value": "6mto2y",
          "label": "6個月～2年"
        },
        {
          "value": "2to10y",
          "label": "2年以上"
        }
      ]
    },
    {
