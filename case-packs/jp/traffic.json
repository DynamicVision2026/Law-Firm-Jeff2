  "jeff": {
    "recommendation": {
      "question": "Should this person consult a lawyer about this traffic accident?",
      "options": [
        "high",
        "medium",
        "low"
      ]
    },
    "urgency": {
      "question": "How urgent is this case?",
      "options": [
        "urgent",
        "normal"
      ]
    },
    "factors": {
      "question": "Which of these factors apply to this case? (choose all that apply)",
      "multi": true,
      "options": [
        "long_treatment",
        "serious_injury",
        "other_party_at_fault",
        "fault_disputed",
        "offer_received",
        "lawyer_rider",
        "possible_after_effects",
        "property_only"
      ]
    },
    "review_threshold": 0.6
  },
  "rules": {
    "_comment": "Lawyer-written scoring used when Jeff is not running, and as the comparison baseline. DRAFT.",
    "score": [
      {
        "if": {
          "injured": "yes"
        },
        "add": 2
      },
      {
        "if": {
          "injury_type": "fracture"
        },
        "add": 2
      },
      {
        "if": {
          "injury_type": "serious"
        },
        "add": 4
      },
      {
        "if": {
          "treatment_months": "3"
        },
        "add": 1
      },
      {
        "if": {
          "treatment_months": [
            "6",
            "7"
          ]
        },
        "add": 2
      },
      {
        "if": {
          "treatment_status": "fixed"
        },
        "add": 2
      },
      {
        "if": {
          "fault": [
            "other_100",
            "other_most"
          ]
        },
        "add": 1
      },
      {
        "if": {
          "fault": "shared"
        },
        "add": 1
      },
      {
        "if": {
          "insurer_offer": "offered"
        },
        "add": 2
      },
      {
        "if": {
          "lawyer_rider": "yes"
        },
        "add": 2
      },
      {
        "if": {
          "fault": "me_most"
        },
        "add": -1
      },
      {
        "if": {
          "injured": "no"
        },
        "add": -1
      }
    ],
    "recommendation_levels": {
      "high": 6,
      "medium": 3
    },
    "value_levels": {
      "high": 7,
      "medium": 3
    },
    "factors": [
      {
        "factor": "serious_injury",
        "if": {
          "injury_type": [
            "fracture",
            "serious"
          ]
        }
      },
      {
        "factor": "possible_after_effects",
        "if": {
          "treatment_status": "fixed"
        }
      },
      {
        "factor": "offer_received",
        "if": {
          "insurer_offer": "offered"
        }
      },
      {
        "factor": "long_treatment",
        "if": {
          "treatment_months": [
            "6",
            "7"
          ]
        }
      },
      {
        "factor": "lawyer_rider",
        "if": {
          "lawyer_rider": "yes"
        }
      },
      {
        "factor": "fault_disputed",
        "if": {
          "fault": [
            "shared",
            "unknown"
          ]
        }
      },
      {
        "factor": "other_party_at_fault",
        "if": {
          "fault": [
            "other_100",
            "other_most"
          ]
        }
      },
      {
        "factor": "property_only",
        "if": {
          "injured": "no"
        }
      }
    ],
    "urgency": [
      {
        "if": {
          "insurer_offer": "signed"
        }
      },
      {
        "if": {
          "accident_when": [
            "3to5y",
            "gt5y"
          ]
        }
      },
      {
        "if": {
          "insurer_offer": "offered"
        }
      }
    ]
  },
  "calculator": {
    "basis": "赤い本（民事交通事故訴訟 損害賠償額算定基準）入通院慰謝料の目安 — 版の確認が必要",
    "unit": "万円",
    "applies_if": {
      "injured": "yes"
    },
    "table_key": "treatment_months",
    "tables": {
      "minor": {
        "used_for": [
          "whiplash"
        ],
        "label": "むちうち等（別表II相当）",
        "ranges": {
          "1": [
            15,
            19
          ],
          "3": [
            40,
            53
          ],
          "6": [
            70,
            89
          ],
          "7": [
            89,
            120
          ]
        }
      },
      "standard": {
        "used_for": [
          "fracture",
          "serious",
          "unknown"
        ],
        "label": "骨折等（別表I相当）",
        "ranges": {
          "1": [
            20,
            28
          ],
          "3": [
            55,
            73
          ],
          "6": [
            90,
            116
          ],
          "7": [
            116,
            160
          ]
        }
      }
    },
    "note": "入通院慰謝料のみの目安です。休業損害・後遺障害・治療費などは含みません。"
  },
  "factors": {
    "long_treatment": "通院期間が長いほど、保険会社の提示と裁判基準の差が大きくなりやすいです。",
    "serious_injury": "骨折や重いケガは、賠償額が大きくなりやすい傾向があります。",
    "other_party_at_fault": "相手の過失が大きい場合、受け取れる金額が減らされにくくなります。",
    "fault_disputed": "過失割合に争いがある場合、専門家の確認で結果が変わることがあります。",
    "offer_received": "保険会社の提示額は、裁判基準より低いことが多いです。",
    "lawyer_rider": "弁護士費用特約があれば、多くの場合、費用の自己負担なく相談・依頼できます。",
    "possible_after_effects": "痛みやしびれが残る場合、後遺障害の認定で賠償額が大きく変わります。",
    "property_only": "物損のみの事故は、弁護士に依頼すると費用が上回ることもあります。"
  },
  "warnings": [
    {
      "id": "signed_settlement",
      "if": {
        "insurer_offer": "signed"
      },
      "level": "high",
      "text": "示談書にサイン済みの場合、原則としてやり直しは困難です。早めに専門家に確認してください。"
    },
    {
      "id": "deadline_near",
      "if": {
        "accident_when": "3to5y"
      },
      "level": "high",
      "text": "請求には期限（時効）があります。物損は事故から3年、人身損害は5年が目安です。お急ぎください。"
    },
    {
      "id": "deadline_passed",
      "if": {
        "accident_when": "gt5y"
      },
      "level": "high",
      "text": "時効が過ぎている可能性があります。例外もあるため、専門家に確認してください。"
    },
    {
      "id": "dont_sign_yet",
      "if": {
        "insurer_offer": "offered"
      },
      "level": "medium",
      "text": "提示額に納得できない場合、まだ示談書にサインしないでください。"
    },
    {
      "id": "keep_treating",
      "if": {
        "treatment_status": "ongoing"
      },
      "level": "info",
      "text": "治療中は、医師の判断に従って通院を続けることが大切です。"
    }
  ],
  "result": {
    "headline": {
      "high": "弁護士への相談：おすすめ度【高】",
      "medium": "弁護士への相談：おすすめ度【中】",
      "low": "弁護士への相談：おすすめ度【低】"
    },
    "value_label": "ケースの初期評価",
    "value": {
      "high": "賠償額が大きくなる可能性があるケースです",
      "medium": "条件によって金額が変わるケースです",
      "low": "金額は比較的小さいと考えられるケースです"
    },
    "range_label": "裁判基準の目安（入通院慰謝料）",
    "cost_note": "弁護士費用特約があれば、多くの場合、自己負担なしで相談・依頼できます。特約がない場合も、初回相談無料の事務所や法テラス（収入要件あり）を利用できます。",
    "next_step": {
      "high": "専門家に早めに相談することをおすすめします。",
      "medium": "保険会社の提示が出たら、一度専門家に確認すると安心です。",
      "low": "まずは保険会社とのやりとりの記録を残しておきましょう。必要に応じて法テラスでも相談できます。"
    },
    "supervision_label": "弁護士監修",
    "disclaimer": "この診断は一般的な情報の提供を目的としたもので、法的助言ではありません。実際の金額や結果は個別の事情により異なります。"
  }
}