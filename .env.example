# Copy this file to ".env" (same folder) and fill in your values.
# ".env" stays on your Mac only — it is never uploaded to GitHub.

# Your Anthropic API key (from console.anthropic.com → API Keys). Leave empty for test mode.
ANTHROPIC_API_KEY=

# The folder where you downloaded Jeff (the one containing pyproject.toml). Leave empty to run without Jeff.
# Example: JEFF_DIR=/Users/brian/jeff
JEFF_DIR=

# Team test: SHARE=yes creates a public link for your team (needs: brew install cloudflared).
# A team password is required when sharing. Send it to the team separately from the link.
SHARE=no
SITE_PASSWORD=

# Optional
PORT=8000
LLM_MODEL=claude-haiku-5-5
